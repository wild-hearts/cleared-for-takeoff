# Medaria Aid shop - environment variables.
# Set these in Vercel -> medaria-aid -> Settings -> Environment Variables.
# NEVER commit real keys. This file documents the names only.

# Stripe secret key for the MEDARIA AID Stripe account (acct_1TS5cK...), NOT the
# Wild Hearts one. Charity income must land in the charity's own account.
# Use a RESTRICTED key with "Checkout Sessions: write".
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret from Stripe -> Developers -> Webhooks -> your medariaaid.com endpoint.
# A webhook secret is per-endpoint. Reusing Little Poppin's will fail signature checks.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Printify personal access token, from the medariaaid@gmail.com account (the one whose
# only store is "Medaria Aid"). Printify -> My Profile -> Connections.
# Scopes: shops.read, catalog.read, products.read, products.write,
#         uploads.read, uploads.write, orders.write
#
# TWO THINGS THAT WILL BITE YOU LATER:
#   1. The token is shown ONCE, immediately after you generate it. Copy it then.
#   2. Printify tokens EXPIRE AFTER ONE YEAR. When it lapses, order submission starts
#      failing and nothing on the site looks broken, because the failure is server-side.
#      Put a reminder in the calendar for eleven months from the day you make it, and
#      watch /api/merch-ops for merch-printify-failed.
PRINTIFY_API_TOKEN=

# Shared key in the Printify webhook URL. Any long random string; it must match the
# ?key=... in the URL registered with Printify. Fails closed if unset.
PRINTIFY_WEBHOOK_KEY=

# Order visibility at /api/merch-ops?key=... Also fails closed if unset.
OPS_SECRET=

# Durable order/event log (Vercel -> Storage -> Blob -> connect).
# Without it the shop still works, but nothing records whether an order reached Printify.
BLOB_READ_WRITE_TOKEN=

# Tracking emails to buyers, via Resend. Optional but strongly recommended:
# without it a buyer pays and then hears nothing until a parcel arrives.
RESEND_API_KEY=
ORDER_FROM_EMAIL="Medaria Aid <orders@medariaaid.com>"
ORDER_NOTIFY_EMAIL=info@medariaaid.com

# Force the site origin used for success/cancel/image URLs. Auto-detected when unset.
SITE_URL=https://www.medariaaid.com
